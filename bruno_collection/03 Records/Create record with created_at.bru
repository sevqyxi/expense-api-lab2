meta {
  name: Create record with created_at
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/record
  body: json
  auth: none
}

body:json {
  {
    "user_id": {{userId}},
    "category_id": {{categoryId}},
    "amount": 99.99,
    "created_at": "2026-11-18T12:30:00+02:00"
  }
}

assert {
  res.status: eq 201
}
